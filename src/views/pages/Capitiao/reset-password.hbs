{{#> layout-capotiao-modern-auth title="Restablecer Contraseña" description="Te enviaremos un enlace para restablecer tu contraseña"}}

<form class="cm-form" onsubmit="return false;">
	<div class="cm-form-group">
		<label class="cm-form-label" for="reset-email">Correo electrónico</label>
		<div class="cm-input-wrap">
			<i class="bi bi-envelope"></i>
			<input type="email" id="reset-email" class="cm-input" placeholder="tucorreo@colegio.com" autocomplete="email">
		</div>
	</div>
	<button type="submit" class="cm-btn cm-btn-primary w-100 cm-btn-lg">
		<i class="bi bi-send"></i> Enviar enlace
	</button>
</form>

<div class="text-center mt-3">
	<small class="text-muted">¿Recordaste tu contraseña?</small>
	<a href="login.html" class="small" style="color:var(--cm-brand);text-decoration:none;font-weight:500;">Inicia sesión</a>
</div>

{{/layout-capotiao-modern-auth}}
