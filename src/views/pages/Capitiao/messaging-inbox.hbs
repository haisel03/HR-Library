{{#> layout-capotiao-modern-tenant icon="bi bi-chat-dots" title="Bandeja de Entrada" description="Mensajería interna" userName="Juan Pérez" userBadge="Director" page="messaging-inbox"}}

<div class="cm-page-header">
	<div class="cm-page-header-inner">
		<div class="cm-page-header-left">
			<div class="cm-page-header-icon"><i class="bi bi-chat-dots"></i></div>
			<h1 class="cm-headline cm-headline-lg">Bandeja de Entrada</h1>
			<div class="cm-breadcrumbs">
				<a href="school-dashboard.html">Inicio</a>
				<span class="sep">/</span>
				<span class="current">Mensajería</span>
			</div>
		</div>
		<div class="cm-page-header-actions">
			<button class="cm-btn cm-btn-primary cm-btn-sm"><i class="bi bi-pencil-square"></i> Redactar</button>
		</div>
	</div>
</div>

<div class="cm-toolbar">
	<div class="cm-toolbar-left">
		<div class="cm-input-wrap">
			<i class="bi bi-search"></i>
			<input type="text" class="cm-input cm-input-sm" placeholder="Buscar mensajes..." style="min-width:200px;">
		</div>
	</div>
	<div class="cm-toolbar-right">
		<button class="cm-btn cm-btn-sm cm-btn-ghost"><i class="bi bi-archive"></i></button>
		<button class="cm-btn cm-btn-sm cm-btn-ghost"><i class="bi bi-trash"></i></button>
		<button class="cm-btn cm-btn-sm cm-btn-ghost"><i class="bi bi-arrow-counterclockwise"></i></button>
	</div>
</div>

<div class="cm-card">
	<div class="cm-card-body p-0">
		<div class="cm-msg-tabs">
			<button class="cm-msg-tab active">Bandeja <span class="cm-badge cm-badge-primary cm-badge-sm">6</span></button>
			<button class="cm-msg-tab">Enviados <span class="cm-badge cm-badge-secondary cm-badge-sm">12</span></button>
			<button class="cm-msg-tab">Borradores <span class="cm-badge cm-badge-warning cm-badge-sm">3</span></button>
		</div>
		<div class="cm-msg-list">
			<div class="cm-msg-item cm-msg-item-unread">
				<div class="cm-msg-avatar cm-msg-avatar-primary">MR</div>
				<div class="cm-msg-body">
					<div class="cm-msg-header">
						<span class="cm-msg-sender">María Rodríguez</span>
						<span class="cm-msg-time">08:45 AM</span>
					</div>
					<div class="cm-msg-subject">Solicitud de revisión de notas - 5to Grado</div>
					<div class="cm-msg-preview">Buenos días, Juan. Quisiera solicitar una revisión de las calificaciones del período 1 para el estudiante Pedro Rodríguez...</div>
				</div>
				<div class="cm-msg-indicator"><span class="cm-msg-unread-dot"></span></div>
			</div>

			<div class="cm-msg-item cm-msg-item-unread">
				<div class="cm-msg-avatar cm-msg-avatar-warning">CM</div>
				<div class="cm-msg-body">
					<div class="cm-msg-header">
						<span class="cm-msg-sender">Carlos Mendoza</span>
						<span class="cm-msg-time">Ayer 03:30 PM</span>
					</div>
					<div class="cm-msg-subject">Reporte de incidentes en el aula</div>
					<div class="cm-msg-preview">Le informo sobre los incidentes ocurridos durante la semana del 17 al 21 de mayo en el curso de Matemáticas...</div>
				</div>
				<div class="cm-msg-indicator"><span class="cm-msg-unread-dot"></span></div>
			</div>

			<div class="cm-msg-item">
				<div class="cm-msg-avatar cm-msg-avatar-info">AT</div>
				<div class="cm-msg-body">
					<div class="cm-msg-header">
						<span class="cm-msg-sender">Ana Torres</span>
						<span class="cm-msg-time">Ayer 11:15 AM</span>
					</div>
					<div class="cm-msg-subject">Solicitud de certificado de estudios</div>
					<div class="cm-msg-preview">Buen día, necesito solicitar el certificado de estudios para mi hija Valentina Gómez, del curso 1er Grado A...</div>
				</div>
				<div class="cm-msg-indicator"></div>
			</div>

			<div class="cm-msg-item">
				<div class="cm-msg-avatar cm-msg-avatar-success">SG</div>
				<div class="cm-msg-body">
					<div class="cm-msg-header">
						<span class="cm-msg-sender">Sistema de Notificaciones</span>
						<span class="cm-msg-time">22/05/2026</span>
					</div>
					<div class="cm-msg-subject">Respaldo automático completado</div>
					<div class="cm-msg-preview">El respaldo automático de la base de datos del día 22/05/2026 se ha completado exitosamente...</div>
				</div>
				<div class="cm-msg-indicator"></div>
			</div>

			<div class="cm-msg-item">
				<div class="cm-msg-avatar cm-msg-avatar-primary">PL</div>
				<div class="cm-msg-body">
					<div class="cm-msg-header">
						<span class="cm-msg-sender">Pedro López</span>
						<span class="cm-msg-time">21/05/2026</span>
					</div>
					<div class="cm-msg-subject">Cotización de equipos tecnológicos</div>
					<div class="cm-msg-preview">Tal como lo solicitó, adjunto la cotización de los 10 equipos de computación para el laboratorio...</div>
				</div>
				<div class="cm-msg-indicator"></div>
			</div>

			<div class="cm-msg-item">
				<div class="cm-msg-avatar cm-msg-avatar-danger">SR</div>
				<div class="cm-msg-body">
					<div class="cm-msg-header">
						<span class="cm-msg-sender">Sofía Ramírez</span>
						<span class="cm-msg-time">20/05/2026</span>
					</div>
					<div class="cm-msg-subject">Justificación de ausencias</div>
					<div class="cm-msg-preview">Estimado Director, por medio de la presente hago constar que mi hijo estuvo ausente los días 18 y 19 de mayo por...</div>
				</div>
				<div class="cm-msg-indicator"></div>
			</div>
		</div>
	</div>
</div>

<style>
.cm-msg-tabs {
	display: flex;
	border-bottom: 1px solid var(--cm-border, #e2e5ea);
	background: var(--cm-surface, #f8f9fa);
	padding: 0 0.75rem;
}
.cm-msg-tab {
	padding: 0.625rem 1rem;
	font-size: 0.825rem;
	font-weight: 500;
	color: var(--cm-text-muted, #6b7280);
	border: none;
	background: none;
	cursor: pointer;
	border-bottom: 2px solid transparent;
	margin-bottom: -1px;
	display: flex;
	align-items: center;
	gap: 0.4rem;
	transition: all 0.15s;
}
.cm-msg-tab:hover { color: var(--cm-text, #1a1d23); }
.cm-msg-tab.active {
	color: var(--cm-primary, #003876);
	border-bottom-color: var(--cm-primary, #003876);
}
.cm-msg-list { display: flex; flex-direction: column; }
.cm-msg-item {
	display: flex;
	align-items: flex-start;
	gap: 0.75rem;
	padding: 0.875rem 1rem;
	border-bottom: 1px solid var(--cm-border, #e2e5ea);
	cursor: pointer;
	transition: background 0.15s;
	position: relative;
}
.cm-msg-item:hover { background: var(--cm-surface-hover, #f1f3f5); }
.cm-msg-item-unread { background: var(--cm-primary-bg, #e8f0fe); }
.cm-msg-item-unread:hover { background: #dce6f8; }
.cm-msg-avatar {
	width: 40px; height: 40px;
	display: flex; align-items: center; justify-content: center;
	border-radius: 50%;
	font-size: 0.75rem;
	font-weight: 600;
	flex-shrink: 0;
}
.cm-msg-avatar-primary { background: var(--cm-primary-bg, #e8f0fe); color: var(--cm-primary, #003876); }
.cm-msg-avatar-warning { background: #fff8e6; color: #c9a227; }
.cm-msg-avatar-info { background: #e8f4fd; color: #5b8fa8; }
.cm-msg-avatar-success { background: #e6f7e6; color: #28a745; }
.cm-msg-avatar-danger { background: #fde8e8; color: #dc3545; }
.cm-msg-body { flex: 1; min-width: 0; }
.cm-msg-header {
	display: flex;
	justify-content: space-between;
	align-items: center;
	margin-bottom: 0.15rem;
}
.cm-msg-sender { font-weight: 600; font-size: 0.875rem; color: var(--cm-text, #1a1d23); }
.cm-msg-time { font-size: 0.75rem; color: var(--cm-text-muted, #6b7280); white-space: nowrap; }
.cm-msg-subject { font-size: 0.8rem; color: var(--cm-text, #1a1d23); margin-bottom: 0.1rem; }
.cm-msg-preview { font-size: 0.78rem; color: var(--cm-text-muted, #6b7280); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.cm-msg-indicator {
	width: 12px;
	display: flex;
	align-items: flex-start;
	justify-content: center;
	padding-top: 12px;
	flex-shrink: 0;
}
.cm-msg-unread-dot {
	width: 8px; height: 8px;
	border-radius: 50%;
	background: var(--cm-primary, #003876);
	display: block;
}
</style>

{{/layout-capotiao-modern-tenant}}