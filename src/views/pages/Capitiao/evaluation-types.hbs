{{#> layout-capotiao-modern-tenant icon="bi bi-tags" title="Tipos de Evaluación" description="Configuración de tipos y pesos de evaluación académica" userName="Juan Pérez" userBadge="Director" page="evaluation-types"}}

<div class="cm-page-header">
	<div class="cm-page-header-inner">
		<div class="cm-page-header-left">
			<div class="cm-page-header-icon"><i class="bi bi-tags"></i></div>
			<h1 class="cm-headline cm-headline-lg">Tipos de Evaluación</h1>
			<div class="cm-breadcrumbs">
				<a href="evaluation-periods.html">Evaluación</a>
				<span class="sep">/</span>
				<span class="current">Tipos de Evaluación</span>
			</div>
		</div>
		<div class="cm-page-header-actions">
			<button class="cm-btn cm-btn-primary cm-btn-sm"><i class="bi bi-plus-lg"></i> Nuevo Tipo</button>
		</div>
	</div>
</div>

<div class="cm-toolbar">
	<div class="cm-toolbar-left">
		<div class="cm-input-wrap">
			<i class="bi bi-search"></i>
			<input type="text" class="cm-input cm-input-sm" placeholder="Buscar tipo de evaluación..." style="min-width:240px;">
		</div>
		<button class="cm-btn cm-btn-sm cm-btn-ghost"><i class="bi bi-funnel"></i> Filtros</button>
	</div>
	<div class="cm-toolbar-right">
		<span class="cm-label">6 tipos</span>
	</div>
</div>

<div class="cm-card">
	<div class="cm-card-body p-0">
		<div class="cm-table-wrap">
			<table class="cm-table">
				<thead>
					<tr><th>Nombre</th><th>Descripción</th><th>Peso %</th><th>Estado</th><th style="width:80px;"></th></tr>
				</thead>
				<tbody>
					<tr>
						<td><strong>Evaluación Diagnóstica</strong></td>
						<td>Evaluación inicial para identificar conocimientos previos al inicio del período</td>
						<td class="cm-data">10%</td>
						<td><span class="cm-dot cm-dot-success"></span> Activo</td>
						<td>
							<div class="cm-actions">
								<button class="cm-btn-icon cm-btn-icon-sm cm-btn-icon-view" title="Ver"><i class="bi bi-eye"></i></button>
								<button class="cm-btn-icon cm-btn-icon-sm cm-btn-icon-edit" title="Editar"><i class="bi bi-pencil"></i></button>
							</div>
						</td>
					</tr>
					<tr>
						<td><strong>Evaluación Formativa</strong></td>
						<td>Seguimiento continuo del aprendizaje mediante actividades y tareas diarias</td>
						<td class="cm-data">30%</td>
						<td><span class="cm-dot cm-dot-success"></span> Activo</td>
						<td>
							<div class="cm-actions">
								<button class="cm-btn-icon cm-btn-icon-sm cm-btn-icon-view" title="Ver"><i class="bi bi-eye"></i></button>
								<button class="cm-btn-icon cm-btn-icon-sm cm-btn-icon-edit" title="Editar"><i class="bi bi-pencil"></i></button>
							</div>
						</td>
					</tr>
					<tr>
						<td><strong>Evaluación Sumativa</strong></td>
						<td>Pruebas parciales y finales que miden el logro de los objetivos de aprendizaje</td>
						<td class="cm-data">40%</td>
						<td><span class="cm-dot cm-dot-success"></span> Activo</td>
						<td>
							<div class="cm-actions">
								<button class="cm-btn-icon cm-btn-icon-sm cm-btn-icon-view" title="Ver"><i class="bi bi-eye"></i></button>
								<button class="cm-btn-icon cm-btn-icon-sm cm-btn-icon-edit" title="Editar"><i class="bi bi-pencil"></i></button>
							</div>
						</td>
					</tr>
					<tr>
						<td><strong>Evaluación de Proyectos</strong></td>
						<td>Trabajos prácticos y proyectos integradores realizados durante el período</td>
						<td class="cm-data">20%</td>
						<td><span class="cm-dot cm-dot-success"></span> Activo</td>
						<td>
							<div class="cm-actions">
								<button class="cm-btn-icon cm-btn-icon-sm cm-btn-icon-view" title="Ver"><i class="bi bi-eye"></i></button>
								<button class="cm-btn-icon cm-btn-icon-sm cm-btn-icon-edit" title="Editar"><i class="bi bi-pencil"></i></button>
							</div>
						</td>
					</tr>
					<tr>
						<td><strong>Autoevaluación</strong></td>
						<td>Proceso donde el estudiante reflexiona y valora su propio desempeño académico</td>
						<td class="cm-data">0%</td>
						<td><span class="cm-dot cm-dot-secondary"></span> Inactivo</td>
						<td>
							<div class="cm-actions">
								<button class="cm-btn-icon cm-btn-icon-sm cm-btn-icon-view" title="Ver"><i class="bi bi-eye"></i></button>
								<button class="cm-btn-icon cm-btn-icon-sm cm-btn-icon-edit" title="Editar"><i class="bi bi-pencil"></i></button>
							</div>
						</td>
					</tr>
					<tr>
						<td><strong>Evaluación Oral</strong></td>
						<td>Exposiciones y sustentaciones orales para evaluar comunicación y dominio del tema</td>
						<td class="cm-data">0%</td>
						<td><span class="cm-dot cm-dot-secondary"></span> Inactivo</td>
						<td>
							<div class="cm-actions">
								<button class="cm-btn-icon cm-btn-icon-sm cm-btn-icon-view" title="Ver"><i class="bi bi-eye"></i></button>
								<button class="cm-btn-icon cm-btn-icon-sm cm-btn-icon-edit" title="Editar"><i class="bi bi-pencil"></i></button>
							</div>
						</td>
					</tr>
				</tbody>
			</table>
		</div>
	</div>
</div>

{{/layout-capotiao-modern-tenant}}
