{{#> layout-capotiao-auth title="Selecciona un Colegio" description="Tienes acceso a varios colegios. Elige uno para continuar." authFooter='<a href="capotiao-login.html" class="text-white-50">Cerrar sesi&oacute;n</a>'}}

<div class="list-group">
	<button type="button" class="list-group-item list-group-item-action d-flex align-items-center select-school" data-school="1">
		<i class="bi bi-building fs-3 me-3 text-primary"></i>
		<div class="text-start">
			<strong>Colegio San Jos&eacute;</strong>
			<small class="d-block text-muted">Rol: <span class="badge bg-primary">Director</span></small>
		</div>
		<i class="bi bi-chevron-right ms-auto"></i>
	</button>
	<button type="button" class="list-group-item list-group-item-action d-flex align-items-center select-school" data-school="2">
		<i class="bi bi-building fs-3 me-3 text-success"></i>
		<div class="text-start">
			<strong>Instituto Moderno</strong>
			<small class="d-block text-muted">Rol: <span class="badge bg-primary">Docente</span></small>
		</div>
		<i class="bi bi-chevron-right ms-auto"></i>
	</button>
	<button type="button" class="list-group-item list-group-item-action d-flex align-items-center select-school" data-school="3">
		<i class="bi bi-building fs-3 me-3 text-info"></i>
		<div class="text-start">
			<strong>Liceo Cultural</strong>
			<small class="d-block text-muted">Rol: <span class="badge bg-primary">Administrador</span></small>
		</div>
		<i class="bi bi-chevron-right ms-auto"></i>
	</button>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
	$('.select-school').on('click', function() {
		const school = $(this).data('school');
		App.success('Accediendo al colegio...');
		setTimeout(() => window.location.href = 'capotiao-school-dashboard.html', 1000);
	});
});
</script>

{{/layout-capotiao-auth}}
