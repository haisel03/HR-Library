{{#> layout-capotiao-tenant icon="bi bi-speedometer2" title="Panel Principal" description="Bienvenido al sistema de gesti&oacute;n escolar" userName="Juan P&eacute;rez" userBadge="Director"}}

<div class="row g-3 mb-4">
	<div class="col-xl-3 col-md-6">
		<div class="card border-start border-primary border-3">
			<div class="card-body d-flex align-items-center justify-content-between">
				<div>
					<h6 class="text-muted mb-1">Estudiantes</h6>
					<h3 class="fw-bold mb-0">1,284</h3>
				</div>
				<i class="bi bi-people fs-1 text-primary opacity-25"></i>
			</div>
		</div>
	</div>
	<div class="col-xl-3 col-md-6">
		<div class="card border-start border-success border-3">
			<div class="card-body d-flex align-items-center justify-content-between">
				<div>
					<h6 class="text-muted mb-1">Docentes</h6>
					<h3 class="fw-bold mb-0">64</h3>
				</div>
				<i class="bi bi-person-workspace fs-1 text-success opacity-25"></i>
			</div>
		</div>
	</div>
	<div class="col-xl-3 col-md-6">
		<div class="card border-start border-warning border-3">
			<div class="card-body d-flex align-items-center justify-content-between">
				<div>
					<h6 class="text-muted mb-1">Aulas</h6>
					<h3 class="fw-bold mb-0">32</h3>
				</div>
				<i class="bi bi-door-open fs-1 text-warning opacity-25"></i>
			</div>
		</div>
	</div>
	<div class="col-xl-3 col-md-6">
		<div class="card border-start border-info border-3">
			<div class="card-body d-flex align-items-center justify-content-between">
				<div>
					<h6 class="text-muted mb-1">Materias</h6>
					<h3 class="fw-bold mb-0">18</h3>
				</div>
				<i class="bi bi-book fs-1 text-info opacity-25"></i>
			</div>
		</div>
	</div>
</div>

<div class="row g-3">
	<div class="col-xl-7">
		<div class="card">
			<div class="card-header bg-white py-3">
				<h6 class="fw-bold mb-0"><i class="bi bi-graph-up me-2"></i>Rendimiento Acad&eacute;mico por Grado</h6>
			</div>
			<div class="card-body">
				<canvas id="academicChart" height="250"></canvas>
			</div>
		</div>
	</div>
	<div class="col-xl-5">
		<div class="card">
			<div class="card-header bg-white py-3">
				<h6 class="fw-bold mb-0"><i class="bi bi-calendar-event me-2"></i>Calendario Escolar</h6>
			</div>
			<div class="card-body p-2">
				<div data-calendar='{
					"initialView": "dayGridMonth",
					"height": 320,
					"headerToolbar": {
						"left": "prev,next",
						"center": "title",
						"right": "dayGridMonth,listWeek"
					},
					"events": [
						{"title": "Reuni&oacute;n de Padres", "start": "2026-05-20", "color": "#4e73df"},
						{"title": "Entrega de Notas", "start": "2026-05-22", "color": "#f6c23e"},
						{"title": "D&iacute;a del Estudiante", "start": "2026-05-30", "color": "#36b9cc"},
						{"title": "Inicio de Vacaciones", "start": "2026-06-15", "color": "#858796"}
					]
				}'></div>
			</div>
		</div>
	</div>
</div>

<div class="row g-3 mt-2">
	<div class="col-12">
		<div class="card">
			<div class="card-header bg-white py-3">
				<h6 class="fw-bold mb-0"><i class="bi bi-clock-history me-2"></i>&Uacute;ltimas Actividades</h6>
			</div>
			<div class="card-body">
				<div class="table-responsive">
					<table class="table table-hover align-middle mb-0">
						<thead class="table-light">
							<tr><th>Fecha</th><th>Usuario</th><th>Actividad</th><th>Estado</th></tr>
						</thead>
						<tbody>
							<tr><td>2026-05-16 10:30</td><td>Juan P&eacute;rez</td><td>Actualizaci&oacute;n de calificaciones - 5to Grado</td><td><span class="badge bg-success">Completado</span></td></tr>
							<tr><td>2026-05-16 09:15</td><td>Mar&iacute;a L&oacute;pez</td><td>Registro de asistencia - 3er Grado</td><td><span class="badge bg-success">Completado</span></td></tr>
							<tr><td>2026-05-15 14:30</td><td>Carlos Mendoza</td><td>Creaci&oacute;n de nuevo curso: Matem&aacute;ticas Avanzadas</td><td><span class="badge bg-success">Completado</span></td></tr>
							<tr><td>2026-05-15 11:00</td><td>Sistema</td><td>Respaldo autom&aacute;tico de base de datos</td><td><span class="badge bg-info">Programado</span></td></tr>
						</tbody>
					</table>
				</div>
			</div>
		</div>
	</div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
	if (typeof Chart !== 'undefined') {
		new Chart(document.getElementById('academicChart'), {
			type: 'bar',
			data: {
				labels: ['1ro', '2do', '3ro', '4to', '5to', '6to'],
				datasets: [
					{ label: 'Promedio General', data: [85, 82, 88, 79, 91, 84], backgroundColor: '#4e73df' },
					{ label: 'Asistencia (%)', data: [95, 92, 94, 89, 96, 91], backgroundColor: '#1cc88a' }
				]
			},
			options: {
				responsive: true, maintainAspectRatio: false,
				scales: { y: { beginAtZero: true, max: 100 } }
			}
		});
	}
});
</script>

{{/layout-capotiao-tenant}}
