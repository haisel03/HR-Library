{{#> layout-main icon="bi bi-speedometer2" title="Analytics Dashboard" description="Resumen general de métricas"}}

<div class="row g-4 animate-stagger" style="--stagger-index: 0;">

	{{!-- Stat Cards --}}
	<div class="col-xl-6 col-xxl-5 d-flex" style="--stagger-index: 0;">
		<div class="w-100">
			<div class="row g-4">
				<div class="col-sm-6">
					<div class="card card--accent h-100 stat-card">
						<div class="card-body">
							<div class="d-flex justify-content-between align-items-start mb-2">
								<h5 class="stat-label">Estudiantes</h5>
								<div class="stat-icon stat-icon--primary">
									<i class="bi bi-people"></i>
								</div>
							</div>
							<h2 class="stat-value">2,382</h2>
							<div>
								<span class="badge bg-danger-subtle text-danger"> <i class="bi bi-arrow-down"></i> -3.65% </span>
								<span class="stat-footnote">vs semana ant.</span>
							</div>
						</div>
					</div>
					<div class="card card--accent h-100 stat-card">
						<div class="card-body">
							<div class="d-flex justify-content-between align-items-start mb-2">
								<h5 class="stat-label">Profesores</h5>
								<div class="stat-icon stat-icon--success">
									<i class="bi bi-briefcase"></i>
								</div>
							</div>
							<h2 class="stat-value">143</h2>
							<div>
								<span class="badge bg-success-subtle text-success"> <i class="bi bi-arrow-up"></i> 5.25% </span>
								<span class="stat-footnote">vs semana ant.</span>
							</div>
						</div>
					</div>
				</div>
				<div class="col-sm-6">
					<div class="card card--accent h-100 stat-card">
						<div class="card-body">
							<div class="d-flex justify-content-between align-items-start mb-2">
								<h5 class="stat-label">Ingresos</h5>
								<div class="stat-icon stat-icon--bronze">
									<i class="bi bi-currency-dollar"></i>
								</div>
							</div>
							<h2 class="stat-value">$21,300</h2>
							<div>
								<span class="badge bg-success-subtle text-success"> <i class="bi bi-arrow-up"></i> 6.65% </span>
								<span class="stat-footnote">vs semana ant.</span>
							</div>
						</div>
					</div>
					<div class="card card--accent h-100 stat-card">
						<div class="card-body">
							<div class="d-flex justify-content-between align-items-start mb-2">
								<h5 class="stat-label">Ordenes</h5>
								<div class="stat-icon stat-icon--info">
									<i class="bi bi-cart"></i>
								</div>
							</div>
							<h2 class="stat-value">64</h2>
							<div>
								<span class="badge bg-danger-subtle text-danger"> <i class="bi bi-arrow-down"></i> -2.25% </span>
								<span class="stat-footnote">vs semana ant.</span>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>

	{{!-- Line Chart --}}
	<div class="col-xl-6 col-xxl-7 d-flex" style="--stagger-index: 1;">
		<div class="card flex-fill w-100">
			<div class="card-header">
				<h5 class="card-title mb-0">
					<i class="bi bi-graph-up"></i> Movimientos Recientes
				</h5>
			</div>
			<div class="card-body py-3">
				<div class="chart chart-sm">
					<canvas id="chartjs-dashboard-line"></canvas>
				</div>
			</div>
		</div>
	</div>
</div>

<div class="row g-4 mt-2 animate-stagger" style="--stagger-index: 2;">
	{{!-- Pie Chart --}}
	<div class="col-12 col-md-6 col-xxl-3 d-flex order-2 order-xxl-3" style="--stagger-index: 0;">
		<div class="card flex-fill w-100">
			<div class="card-header">
				<h5 class="card-title mb-0">
					<i class="bi bi-pie-chart"></i> Distribución por Grado
				</h5>
			</div>
			<div class="card-body d-flex">
				<div class="align-self-center w-100">
					<div class="py-3">
						<div class="chart chart-xs">
							<canvas id="chartjs-dashboard-pie"></canvas>
						</div>
					</div>
					<table class="table mb-0">
						<tbody>
							<tr>
								<td>Primaria</td>
								<td class="text-end fw-semibold">4,306</td>
							</tr>
							<tr>
								<td>Secundaria</td>
								<td class="text-end fw-semibold">3,801</td>
							</tr>
							<tr>
								<td>Inicial</td>
								<td class="text-end fw-semibold">1,689</td>
							</tr>
						</tbody>
					</table>
				</div>
			</div>
		</div>
	</div>

	{{!-- Map --}}
	<div class="col-12 col-md-12 col-xxl-6 d-flex order-3 order-xxl-2" style="--stagger-index: 1;">
		<div class="card flex-fill w-100">
			<div class="card-header">
				<h5 class="card-title mb-0">
					<i class="bi bi-globe"></i> Real-Time
				</h5>
			</div>
			<div class="card-body px-4">
				<div id="world_map" style="height:350px;"></div>
			</div>
		</div>
	</div>

	{{!-- Calendar --}}
	<div class="col-12 col-md-6 col-xxl-3 d-flex order-1 order-xxl-1" style="--stagger-index: 2;">
		<div class="card flex-fill w-100">
			<div class="card-header">
				<h5 class="card-title mb-0">
					<i class="bi bi-calendar3"></i> Calendario
				</h5>
			</div>
			<div class="card-body d-flex">
				<div class="align-self-center w-100">
					<div class="chart">
						<input type="hidden" id="datetimepicker-dashboard">
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

<div class="row g-4 mt-2 animate-stagger" style="--stagger-index: 4;">
	{{!-- Projects Table --}}
	<div class="col-12 col-lg-8 col-xxl-9 d-flex" style="--stagger-index: 0;">
		<div class="card flex-fill w-100">
			<div class="card-header">
				<h5 class="card-title mb-0">
					<i class="bi bi-kanban"></i> Últimos Proyectos
				</h5>
			</div>
			<div class="table-responsive">
				<table class="table table-hover my-0">
					<thead>
						<tr>
							<th>Nombre</th>
							<th class="d-none d-xl-table-cell">Fecha Inicio</th>
							<th class="d-none d-xl-table-cell">Fecha Fin</th>
							<th>Estado</th>
							<th class="d-none d-md-table-cell">Asignado a</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td class="fw-semibold">Project Apollo</td>
							<td class="d-none d-xl-table-cell">01/01/2023</td>
							<td class="d-none d-xl-table-cell">31/06/2023</td>
							<td><span class="badge bg-success">Done</span></td>
							<td class="d-none d-md-table-cell">Vanessa Tucker</td>
						</tr>
						<tr>
							<td class="fw-semibold">Project Fireball</td>
							<td class="d-none d-xl-table-cell">01/01/2023</td>
							<td class="d-none d-xl-table-cell">31/06/2023</td>
							<td><span class="badge bg-danger">Cancelled</span></td>
							<td class="d-none d-md-table-cell">William Harris</td>
						</tr>
						<tr>
							<td class="fw-semibold">Project Hades</td>
							<td class="d-none d-xl-table-cell">01/01/2023</td>
							<td class="d-none d-xl-table-cell">31/06/2023</td>
							<td><span class="badge bg-warning text-dark">In progress</span></td>
							<td class="d-none d-md-table-cell">Sharon Lessman</td>
						</tr>
						<tr>
							<td class="fw-semibold">Project Nitro</td>
							<td class="d-none d-xl-table-cell">01/01/2023</td>
							<td class="d-none d-xl-table-cell">31/06/2023</td>
							<td><span class="badge bg-warning text-dark">In progress</span></td>
							<td class="d-none d-md-table-cell">Vanessa Tucker</td>
						</tr>
						<tr>
							<td class="fw-semibold">Project Phoenix</td>
							<td class="d-none d-xl-table-cell">01/01/2023</td>
							<td class="d-none d-xl-table-cell">31/06/2023</td>
							<td><span class="badge bg-success">Done</span></td>
							<td class="d-none d-md-table-cell">William Harris</td>
						</tr>
						<tr>
							<td class="fw-semibold">Project X</td>
							<td class="d-none d-xl-table-cell">01/01/2023</td>
							<td class="d-none d-xl-table-cell">31/06/2023</td>
							<td><span class="badge bg-success">Done</span></td>
							<td class="d-none d-md-table-cell">Sharon Lessman</td>
						</tr>
						<tr>
							<td class="fw-semibold">Project Romeo</td>
							<td class="d-none d-xl-table-cell">01/01/2023</td>
							<td class="d-none d-xl-table-cell">31/06/2023</td>
							<td><span class="badge bg-success">Done</span></td>
							<td class="d-none d-md-table-cell">Christina Mason</td>
						</tr>
						<tr>
							<td class="fw-semibold">Project Wombat</td>
							<td class="d-none d-xl-table-cell">01/01/2023</td>
							<td class="d-none d-xl-table-cell">31/06/2023</td>
							<td><span class="badge bg-warning text-dark">In progress</span></td>
							<td class="d-none d-md-table-cell">William Harris</td>
						</tr>
					</tbody>
				</table>
			</div>
		</div>
	</div>

	{{!-- Bar Chart --}}
	<div class="col-12 col-lg-4 col-xxl-3 d-flex" style="--stagger-index: 1;">
		<div class="card flex-fill w-100">
			<div class="card-header">
				<h5 class="card-title mb-0">
					<i class="bi bi-bar-chart"></i> Ventas Mensuales
				</h5>
			</div>
			<div class="card-body d-flex w-100">
				<div class="align-self-center chart chart-lg">
					<canvas id="chartjs-dashboard-bar"></canvas>
				</div>
			</div>
		</div>
	</div>
</div>

{{/layout-main}}