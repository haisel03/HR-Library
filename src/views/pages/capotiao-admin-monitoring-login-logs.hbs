{{#> layout-capotiao-admin icon="bi bi-shield-lock" title="Inicios de Sesi&oacute;n" description="Registro de accesos al sistema" userName="Super Admin" userBadge="Super Admin"}}

<div class="card">
	<div class="card-header bg-white py-3">
		<h6 class="fw-bold mb-0"><i class="bi bi-shield-lock me-2"></i>Historial de Inicios de Sesi&oacute;n</h6>
	</div>
	<div class="card-body">
		<div class="table-responsive">
			<table class="table table-hover align-middle w-100" id="loginLogsTable">
				<thead>
					<tr>
						<th>#</th>
						<th>Usuario</th>
						<th>Email</th>
						<th>IP</th>
						<th>Dispositivo</th>
						<th>Estado</th>
						<th>Fecha</th>
					</tr>
				</thead>
				<tbody></tbody>
			</table>
		</div>
	</div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
	const mockData = [
		{ id: 1, name: 'Super Admin', email: 'admin@capotiao.test', ip: '192.168.1.100', device: 'Chrome / Windows', status: 'success', created_at: '2026-05-16 10:30:00' },
		{ id: 2, name: 'Super Admin', email: 'admin@capotiao.test', ip: '192.168.1.100', device: 'Chrome / Windows', status: 'success', created_at: '2026-05-15 08:00:00' },
		{ id: 3, name: 'Juan P&eacute;rez', email: 'juan@sanjose.test', ip: '10.0.0.50', device: 'Firefox / macOS', status: 'success', created_at: '2026-05-14 14:30:00' },
		{ id: 4, name: 'Desconocido', email: 'bot@malicious.test', ip: '203.0.113.42', device: 'Unknown', status: 'failed', created_at: '2026-05-14 03:15:00' },
		{ id: 5, name: 'Mar&iacute;a G.', email: 'maria@moderno.test', ip: '10.0.1.25', device: 'Safari / iOS', status: 'success', created_at: '2026-05-13 07:45:00' },
	];

	$('#loginLogsTable').DataTable({
		data: mockData,
		columns: [
			{ data: 'id' },
			{ data: 'name' },
			{ data: 'email' },
			{ data: 'ip' },
			{ data: 'device' },
			{ data: 'status', render: v => v === 'success' ? '<span class="badge bg-success">Exitoso</span>' : '<span class="badge bg-danger">Fallido</span>' },
			{ data: 'created_at' },
		],
		order: [[6, 'desc']],
		language: { url: 'https://cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json' },
		pageLength: 25
	});
});
</script>

{{/layout-capotiao-admin}}
