<!DOCTYPE html>
<html lang="es">
{{> head}}

<body class="auth-body">
	<div class="auth-noise"></div>
	<div class="auth-orb auth-orb--1"></div>
	<div class="auth-orb auth-orb--2"></div>
	<main class="d-flex w-100">
		<div class="container d-flex flex-column">
			<div class="row vh-100">
				<div class="col-sm-10 col-md-8 col-lg-6 col-xl-5 mx-auto d-flex align-items-center">

					<div class="w-100">

						<div class="text-center mb-5">

							<h1 class="auth-logo mb-4">
								<span class="text-bronze">HR</span> Library
							</h1>

							<h2 class="auth-title">
								{{title}}
							</h2>

							<p class="auth-description">
								{{description}}
							</p>

						</div>

						{{> @partial-block}}

					</div>

				</div>
			</div>
		</div>
	</main>
</body>

</html>
