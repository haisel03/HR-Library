<!DOCTYPE html>
<html lang="es">
{{> head}}

<body>
	<div class="wrapper">
		{{> sidebar}}

		<div class="main overflow-hidden vh-100">
			{{> navbar-panel}}

			<div class="panel-mode-container d-flex flex-column h-100" style="background: #F5F0EB;">
				<div class="panel-tabs-bar" style="background: #EAE3DB; border-bottom: 1px solid #D5CCC2; display: flex; align-items: center; padding: 0;">

					<div class="flex-grow-1 overflow-hidden">
						<ul class="nav nav-pills nav-tabs-iframe flex-nowrap mb-0" id="iframe-tabs" role="tablist"
							style="overflow-x: auto;">
						</ul>
					</div>
					<div class="dropdown border-start" style="border-color: #D5CCC2 !important;">
						<button class="btn btn-primary text-white dropdown-toggle rounded-0 py-2 border-0" type="button"
							data-bs-toggle="dropdown">
							<i class="bi bi-gear-fill me-1"></i> Opciones
						</button>
						<ul class="dropdown-menu shadow border-0">
							<li>
								<a class="dropdown-item" href="#" id="btnIframeFullscreen">
									<i class="bi bi-arrows-fullscreen me-2"></i>Pantalla Completa
								</a>
							</li>
							<li>
								<a class="dropdown-item" href="#" id="btnIframeRefresh">
									<i class="bi bi-arrow-clockwise me-2"></i>Actualizar
								</a>
							</li>
							<li>
								<hr class="dropdown-divider">
							</li>
							<li>
								<a class="dropdown-item" href="#" id="btnCloseOthers">
									<i class="bi bi-dash-circle me-2"></i>Cerrar los Demás
								</a>
							</li>
							<li>
								<a class="dropdown-item text-danger" href="#" id="btnCloseAll">
									<i class="bi bi-x-circle me-2"></i>Cerrar Todo
								</a>
							</li>
						</ul>
					</div>
				</div>

				<div class="tab-content flex-grow-1 position-relative iframe-contents-wrapper" id="iframe-contents">
					<div
						class="tab-empty d-flex align-items-center justify-content-center h-100 flex-column text-muted opacity-50">
						<i class="bi bi-window-plus display-1 mb-3" style="color: #C4956A;"></i>
						<h4 class="fw-bold" style="color: #0F1F33; font-family: 'Fraunces', serif;">HR-Panel v1.0</h4>
						<p>Selecciona una página en el menú lateral para abrir una pestaña.</p>
					</div>
				</div>
			</div>
		</div>
	</div>
</body>

</html>
